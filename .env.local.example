# Copia questo file in .env.local e riempi con i valori reali.
# .env.local non va mai committato (è già in .gitignore).

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Indirizzi autorizzati a ricevere il codice di accesso, separati da
# virgola. Ognuno deve anche esistere già come utente in Supabase Auth
# (Authentication → Users → Add user), altrimenti il codice non parte.
ALLOWED_LOGIN_EMAILS=galano.raffaele@gmail.com
