# Copia questo file in .env.local e riempi con i valori reali.
# .env.local non va mai committato (è già in .gitignore).

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lascia beta per la versione attuale. Solo il NUOVO sito usa freemium
# e le stesse chiavi del progetto BETA, con supabase/freemium applicato.
NEXT_PUBLIC_APP_EDITION=beta

# Indirizzi autorizzati a ricevere il codice di accesso, separati da
# virgola. Ognuno deve anche esistere già come utente in Supabase Auth
# (Authentication → Users → Add user), altrimenti il codice non parte.
ALLOWED_LOGIN_EMAILS=galano.raffaele@gmail.com

# Riconoscimento piante
PLANTNET_API_KEY=
GEMINI_API_KEY=

# Opzionale: Google Cloud Console → abilita Cloud Vision API e crea una API key.
# Usata solo server-side per Web Detection, come indizio aggiuntivo al riconoscimento.
GOOGLE_CLOUD_VISION_API_KEY=
